# Python
.venv/
__pycache__/
*.pyc
# Upstream vendored sources — track via patches/ instead.
vendor/
# MAME build artifacts (we don't run that build inside the workspace tree,
# but be defensive). Workspace `build/` is tracked because it holds
# preprocessor outputs.
vendor/*/build/
# ROMs (legal sourcing required, never check in)
roms/*
!roms/.gitkeep
# Service manuals / scans (downloaded out-of-band, large binaries)
docs/centipede/*
!docs/centipede/.gitkeep
docs/wells-gardner/*
!docs/wells-gardner/.gitkeep
docs/cojag/*
!docs/cojag/.gitkeep
scans/centipede/*
!scans/centipede/.gitkeep
# Throwaway experiments
scratch/
# Test outputs
log_*.log
# Generic large binary types
*.pdf
*.zip

# Graphify generated artifacts
graphify-out/
**/graphify-out/

# Tauri / Rust build artifacts
src-tauri/target/

# PyInstaller build artifacts — the real sidecar binary and work dir.
# The dev stub (dist/arcade-sim-server-*) IS tracked in git.
build/pyinstaller/work/
dist/arcade-sim-server
# Placeholder icons are tracked; real ones generated before release.
# src-tauri/icons/ is intentionally NOT in .gitignore.

