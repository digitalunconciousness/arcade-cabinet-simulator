{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcade Fault Simulator",
  "version": "0.1.0",
  "identifier": "com.arcade-sim.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:5050",
    "beforeDevCommand": "",
    "beforeBuildCommand": "bash build/pyinstaller/build.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arcade Fault Simulator",
        "url": "tauri://localhost/splash.html",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "externalBin": ["../dist/arcade-sim-server"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": []
  }
}
