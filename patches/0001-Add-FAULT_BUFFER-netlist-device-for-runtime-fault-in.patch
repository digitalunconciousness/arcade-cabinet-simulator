@@ -0,0 +1,107 @@
+// license:BSD-3-Clause
+// copyright-holders:Arcade Cabinet Fault Simulator
+/*
+ * nld_fault_buffer.cpp
+ *
+ *  Transparent buffer with runtime fault injection. In MODE_NORMAL, output Y
+ *  tracks input A. Other modes simulate the digital fault primitives the
+ *  Arcade Cabinet Fault Simulator project relies on.
+ *
+ *          +--------------+
+ *      VCC |1     ++     4| Y
+ *        A |2            3| GND
+ *          +--------------+
+ *
+ *  Runtime parameter:
+ *    MODE 0 = NORMAL    (Y follows A)
+ *    MODE 1 = STUCK_HI  (Y driven high regardless of A)
+ *    MODE 2 = STUCK_LO  (Y driven low  regardless of A)
+ *    MODE 3 = OPEN      (Y high-impedance — pin appears disconnected)
+ *
+ *  Inserted by the auto-instrumentation preprocessor on every fault-eligible
+ *  net pin in the Centipede netlist. Pass-through default keeps solver
+ *  overhead minimal until a fault is actually activated.
+ */
+
+#include "nl_base.h"
+
+namespace netlist::devices {
+
+	NETLIB_OBJECT(fault_buffer)
+	{
+		NETLIB_CONSTRUCTOR(fault_buffer)
+		, m_FT(*this, "FORCE_TRISTATE_LOGIC", 1)
+		, m_A(*this, "A", NETLIB_DELEGATE(input_changed))
+		, m_mode(*this, "MODE", 0)
+		, m_Y(*this, "Y", m_FT())
+		, m_power_pins(*this)
+		{
+		}
+
+	private:
+		// Mode encoding — keep in sync with the preprocessor manifest.
+		static constexpr int MODE_NORMAL   = 0;
+		static constexpr int MODE_STUCK_HI = 1;
+		static constexpr int MODE_STUCK_LO = 2;
+		static constexpr int MODE_OPEN     = 3;
+
+		// Switching delays (typical 74xx buffer figures; tune later).
+		static constexpr netlist_time TS_OFF_ON = NLTIME_FROM_NS(11);
+		static constexpr netlist_time TS_ON_OFF = NLTIME_FROM_NS(13);
+		static constexpr netlist_time SIG_DELAY = NLTIME_FROM_NS(1);
+
+		NETLIB_RESETI()
+		{
+			m_Y.set_tristate(0, TS_OFF_ON, TS_ON_OFF);
+			m_Y.push(0, SIG_DELAY);
+		}
+
+		// Called once at startup and on any runtime change to MODE.
+		NETLIB_UPDATE_PARAMI()
+		{
+			drive_output();
+		}
+
+		// Called whenever input A toggles.
+		NETLIB_HANDLERI(input_changed)
+		{
+			drive_output();
+		}
+
+		void drive_output()
+		{
+			switch (m_mode())
+			{
+				case MODE_NORMAL:
+					m_Y.set_tristate(0, TS_OFF_ON, TS_ON_OFF);
+					m_Y.push(m_A() ? 1 : 0, SIG_DELAY);
+					break;
+				case MODE_STUCK_HI:
+					m_Y.set_tristate(0, TS_OFF_ON, TS_ON_OFF);
+					m_Y.push(1, SIG_DELAY);
+					break;
+				case MODE_STUCK_LO:
+					m_Y.set_tristate(0, TS_OFF_ON, TS_ON_OFF);
+					m_Y.push(0, SIG_DELAY);
+					break;
+				case MODE_OPEN:
+					m_Y.set_tristate(1, TS_OFF_ON, TS_ON_OFF);
+					break;
+				default:
+					// Unknown mode: behave as NORMAL to avoid silent breakage.
+					m_Y.set_tristate(0, TS_OFF_ON, TS_ON_OFF);
+					m_Y.push(m_A() ? 1 : 0, SIG_DELAY);
+					break;
+			}
+		}
+
+		param_logic_t      m_FT;
+		logic_input_t      m_A;
+		param_int_t        m_mode;
+		tristate_output_t  m_Y;
+		nld_power_pins     m_power_pins;
+	};
+
+	NETLIB_DEVICE_IMPL(fault_buffer, "FAULT_BUFFER", "+A,@VCC,@GND")
+
+} // namespace netlist::devices
