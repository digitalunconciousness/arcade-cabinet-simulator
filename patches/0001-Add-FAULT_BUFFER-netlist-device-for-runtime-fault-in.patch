+
+// usage       : FAULT_BUFFER(name, A)
+// auto connect: VCC, GND
+#define FAULT_BUFFER(name, ...) \
+	__VA_OPT__(NET_CHECK_PARAM_COUNT(FAULT_BUFFER, PNARGS(__VA_ARGS__), 1)) \
+	NET_REGISTER_DEV(FAULT_BUFFER, name __VA_OPT__(,) __VA_ARGS__)
+
