 create mode 100644 plugins/cabinet_bus/plugin.json

diff --git a/plugins/cabinet_bus/init.lua b/plugins/cabinet_bus/init.lua
new file mode 100644
index 00000000..522fdd44
--- /dev/null
+++ b/plugins/cabinet_bus/init.lua
@@ -0,0 +1,241 @@
+-- license:BSD-3-Clause
+-- copyright-holders:Arcade Cabinet Fault Simulator
+--
+-- Cabinet-bus plugin for MAME. Opens a TCP listener on 127.0.0.1:5051
+-- and accepts JSON-line commands from the cabinet-bus Flask server,
+-- letting the browser UI control the running emulator (pause / resume /
+-- soft reset / state query).
+--
+-- Protocol
+-- --------
+-- Both directions speak newline-terminated JSON objects. One request
+-- yields one reply; replies always include an `ok` boolean.
+--
+-- Supported commands:
+--   {"cmd":"ping"}                    -> {"ok":true,"pong":true,"app":"...","version":"..."}
+--   {"cmd":"get_state"}               -> {"ok":true,"rom":"centiped3","paused":false,"frame":12345,...}
+--   {"cmd":"pause"}                   -> {"ok":true,"paused":true}
+--   {"cmd":"resume"}                  -> {"ok":true,"paused":false}
+--   {"cmd":"soft_reset"}              -> {"ok":true}
+--   {"cmd":"poke_ram","addr":N,"value":N}                 -> one-shot byte write to the main CPU's program space
+--   {"cmd":"stuck_byte","addr":N,"value":N|null,"cpu":"maincpu"}  -> arm/disarm a per-frame stuck-at fault on a memory cell
+--   {"cmd":"clear_stuck"}             -> remove all armed stuck-at faults
+--
+-- Unknown commands return {"ok":false,"error":"..."}.
+--
+-- Loaded with: ./mame -plugin cabinet_bus ...
+
+local exports = {
+    name        = "cabinet_bus",
+    version     = "0.1.0",
+    description = "Cabinet bus bridge for the Arcade Cabinet Fault Simulator",
+    license     = "BSD-3-Clause",
+    author      = { name = "Arcade Cabinet Fault Simulator" },
+}
+
+local cabinet_bus = exports
+
+local LISTEN_ADDR = "socket.127.0.0.1:5051"
+local READ_CHUNK  = 4096
+
+local reset_subscription, stop_subscription, frame_subscription
+
+function cabinet_bus.startplugin()
+    local json = require("json")
+
+    local socket = emu.file("", 7)  -- flag 7 == socket
+    local err = socket:open(LISTEN_ADDR)
+    if err then
+        emu.print_error("cabinet_bus: failed to open " .. LISTEN_ADDR .. ": " .. tostring(err))
+        return
+    end
+    emu.print_info("cabinet_bus: listening on " .. LISTEN_ADDR)
+
+    local buffer = ""        -- partial bytes pending newline
+    local frame_count = 0
+
+    -- Stuck-at fault table. Key is a string "<cpu_tag>:0x<addr>"; value is
+    -- a table {cpu = string, addr = int, value = int}. Every frame we walk
+    -- this and re-write the cell, so the running game can't "heal" it.
+    -- This is the same fault model BAD_RAM_CELL implements at the netlist
+    -- layer, applied here at the MAME-CPU layer where it actually shows up
+    -- in the rendered frame.
+    local stuck_bytes = {}
+
+    -- Resolve a CPU tag to its program-space memory accessor. We cache to
+    -- avoid hitting the device tree every frame.
+    local space_cache = {}
+    local function space_for(cpu_tag)
+        cpu_tag = cpu_tag or "maincpu"
+        if space_cache[cpu_tag] then return space_cache[cpu_tag] end
+        local mach = manager.machine
+        if not mach then return nil end
+        -- MAME 0.287 device-tree lookup: leading ':' is required.
+        local lookup = cpu_tag
+        if lookup:sub(1,1) ~= ":" then lookup = ":" .. lookup end
+        local dev = mach.devices[lookup]
+        if not dev then return nil end
+        local sp = dev.spaces and dev.spaces["program"]
+        if not sp then return nil end
+        space_cache[cpu_tag] = sp
+        return sp
+    end
+
+    local function reapply_stuck()
+        for _, e in pairs(stuck_bytes) do
+            local sp = space_for(e.cpu)
+            if sp then
+                sp:write_u8(e.addr, e.value)
+            end
+        end
+    end
+
+    -- Update a frame counter so we can report progress to the UI, and
+    -- re-apply any armed stuck-at faults so the running game keeps seeing
+    -- the corrupted cell.
+    frame_subscription = emu.add_machine_frame_notifier(function ()
+        frame_count = frame_count + 1
+        reapply_stuck()
+    end)
+
+    reset_subscription = emu.add_machine_reset_notifier(function ()
+        frame_count = 0
+        space_cache = {}
+    end)
+
+    stop_subscription = emu.add_machine_stop_notifier(function ()
+        if socket then
+            socket:close()
+            socket = nil
+        end
+    end)
+
+    -- Compose a state snapshot for replies.
+    local function snapshot_state()
+        local mach = manager.machine
+        local rom = emu.romname() or ""
+        if rom == "___empty" then rom = "" end
+        local paused = false
+        if mach and mach.paused ~= nil then paused = mach.paused end
+        return {
+            ok      = true,
+            rom     = rom,
+            paused  = paused,
+            frame   = frame_count,
+            app     = emu.app_name(),
+            version = emu.app_version(),
+        }
+    end
+
+    local function send_json(obj)
+        if not socket then return end
+        local line = json.stringify(obj) .. "\n"
+        socket:write(line)
+    end
+
+    local function handle_command(cmd_obj)
+        local cmd = cmd_obj.cmd
+        if cmd == "ping" then
+            return { ok = true, pong = true, app = emu.app_name(), version = emu.app_version() }
+        elseif cmd == "get_state" then
+            return snapshot_state()
+        elseif cmd == "pause" then
+            -- emu.pause() forwards to machine().pause(); the method is
+            -- exposed on the emu module rather than on machine itself.
+            emu.pause()
+            local s = snapshot_state()
+            s.paused = true
+            return s
+        elseif cmd == "resume" then
+            emu.unpause()
+            local s = snapshot_state()
+            s.paused = false
+            return s
+        elseif cmd == "soft_reset" then
+            local mach = manager.machine
+            if mach then mach:soft_reset() end
+            return { ok = true, reset = "soft" }
+        elseif cmd == "poke_ram" then
+            -- One-shot write. Note that for game-managed regions like
+            -- VRAM the game will overwrite within a frame; use stuck_byte
+            -- for persistent faults.
+            local addr = tonumber(cmd_obj.addr)
+            local value = tonumber(cmd_obj.value)
+            local cpu = cmd_obj.cpu or "maincpu"
+            if not addr or not value then
+                return { ok = false, error = "poke_ram: addr and value are required" }
+            end
+            local sp = space_for(cpu)
+            if not sp then
+                return { ok = false, error = "poke_ram: no program space for cpu " .. tostring(cpu) }
+            end
+            sp:write_u8(addr, value & 0xff)
+            return { ok = true, addr = addr, value = value & 0xff, cpu = cpu }
+        elseif cmd == "stuck_byte" then
+            -- Arm or disarm a per-frame stuck-at fault. Pass value=null
+            -- (or omit) to clear that particular address.
+            local addr = tonumber(cmd_obj.addr)
+            local cpu = cmd_obj.cpu or "maincpu"
+            if not addr then
+                return { ok = false, error = "stuck_byte: addr is required" }
+            end
+            local key = cpu .. ":" .. string.format("0x%04x", addr)
+            if cmd_obj.value == nil or cmd_obj.value == json.null then
+                stuck_bytes[key] = nil
+                return { ok = true, action = "cleared", addr = addr, cpu = cpu }
+            end
+            local value = tonumber(cmd_obj.value)
+            if not value then
+                return { ok = false, error = "stuck_byte: value must be a number or null" }
+            end
+            stuck_bytes[key] = { cpu = cpu, addr = addr, value = value & 0xff }
+            -- Apply immediately so the user sees the fault even when paused.
+            reapply_stuck()
+            return { ok = true, action = "armed", addr = addr, value = value & 0xff, cpu = cpu }
+        elseif cmd == "clear_stuck" then
+            local n = 0
+            for _ in pairs(stuck_bytes) do n = n + 1 end
+            stuck_bytes = {}
+            return { ok = true, cleared = n }
+        else
+            return { ok = false, error = "unknown command: " .. tostring(cmd) }
+        end
+    end
+
+    -- Pump the socket once per emulator periodic tick (≈ once per frame
+    -- when running, more often when paused). One read, parse newline-
+    -- delimited JSON objects out of the buffer, dispatch each.
+    emu.register_periodic(function ()
+        if not socket then return end
+
+        -- Drain pending bytes.
+        repeat
+            local chunk = socket:read(READ_CHUNK)
+            if chunk and #chunk > 0 then
+                buffer = buffer .. chunk
+            end
+        until not chunk or #chunk < READ_CHUNK
+
+        while true do
+            local nl = buffer:find("\n", 1, true)
+            if not nl then break end
+            local line = buffer:sub(1, nl - 1)
+            buffer = buffer:sub(nl + 1)
+            if #line > 0 then
+                local ok_parse, cmd_obj = pcall(json.parse, line)
+                if not ok_parse or type(cmd_obj) ~= "table" then
+                    send_json({ ok = false, error = "invalid JSON: " .. tostring(cmd_obj) })
+                else
+                    local ok_handle, reply = pcall(handle_command, cmd_obj)
+                    if not ok_handle then
+                        send_json({ ok = false, error = "handler failed: " .. tostring(reply) })
+                    else
+                        send_json(reply)
+                    end
+                end
+            end
+        end
+    end)
+end
+
+return exports
diff --git a/plugins/cabinet_bus/plugin.json b/plugins/cabinet_bus/plugin.json
new file mode 100644
index 00000000..a7ec62b3
--- /dev/null
+++ b/plugins/cabinet_bus/plugin.json
@@ -0,0 +1,10 @@
+{
+  "plugin": {
+    "name": "cabinet_bus",
+    "description": "Cabinet bus bridge for the Arcade Cabinet Fault Simulator",
+    "version": "0.1.0",
+    "author": "Arcade Cabinet Fault Simulator",
+    "type": "plugin",
+    "start": "false"
+  }
+}
