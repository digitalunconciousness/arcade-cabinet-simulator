+// license:BSD-3-Clause
+// copyright-holders:Arcade Cabinet Fault Simulator
+/*
+ * nld_bad_ram_cell.cpp
+ *
+ *  Small (16 x 1) static RAM with cell-level fault injection. Models a
+ *  stuck-at fault that lives at a single configurable address; all
+ *  other cells behave like a normal SRAM. The architectural pattern
+ *  follows MAME's nld_2102a.cpp; the storage is a state_container so
+ *  it survives netlist save/load.
+ *
+ *  Pin map:
+ *      A0..A3   address inputs (4 bits -> 16 cells)
+ *      CEQ      chip enable, active low
+ *      RWQ      read/write, low = write, high = read
+ *      DI       data input (1 bit)
+ *      DO       data output (1 bit)
+ *
+ *  Parameters:
+ *      BAD_ADDR  the address whose cell is faulty (0..15)
+ *      MODE      0 = NORMAL    (no fault, full RAM behavior)
+ *                1 = STUCK_HI  (cell at BAD_ADDR reads as 1, writes drop)
+ *                2 = STUCK_LO  (cell at BAD_ADDR reads as 0, writes drop)
+ *                3 = FLIP      (cell at BAD_ADDR returns inverted of stored)
+ *
+ *  This is a v1 model: 16 cells x 1 bit at a single bit width. A fuller
+ *  Phase 5.5 RAM region (the full Centipede working RAM) chains four of
+ *  these to give 1024x4 with the same fault-injection surface.
+ */
+
+#include "nl_base.h"
+
+namespace netlist::devices {
+
+	NETLIB_OBJECT(bad_ram_cell)
+	{
+		NETLIB_CONSTRUCTOR(bad_ram_cell)
+		, m_A(*this, {"A0", "A1", "A2", "A3"}, NETLIB_DELEGATE(inputs))
+		, m_CEQ(*this, "CEQ", NETLIB_DELEGATE(inputs))
+		, m_RWQ(*this, "RWQ", NETLIB_DELEGATE(inputs))
+		, m_DI(*this, "DI", NETLIB_DELEGATE(inputs))
+		, m_DO(*this, "DO")
+		, m_bad_addr(*this, "BAD_ADDR", 0)
+		, m_mode(*this, "MODE", 0)
+		, m_ram(*this, "m_ram", 0)
+		, m_power_pins(*this)
+		{
+		}
+
+	private:
+		// Mode encoding — keep in sync with the Python-side runner if any.
+		static constexpr int MODE_NORMAL   = 0;
+		static constexpr int MODE_STUCK_HI = 1;
+		static constexpr int MODE_STUCK_LO = 2;
+		static constexpr int MODE_FLIP     = 3;
+
+		// Number of cells; address width is 4 bits so 16 cells.
+		static constexpr std::size_t NUM_CELLS = 16;
+
+		// Read access time approximating the 2114 (~250 ns).
+		static constexpr netlist_time ACCESS_DELAY = NLTIME_FROM_NS(250);
+
+		NETLIB_RESETI()
+		{
+			for (std::size_t i = 0; i < NUM_CELLS; i++)
+				m_ram[i] = 0;
+		}
+
+		NETLIB_HANDLERI(inputs)
+		{
+			if (m_CEQ())
+				return;  // chip not selected; output stays in last state
+
+			const unsigned a = (m_A[0]() << 0) |
+			                   (m_A[1]() << 1) |
+			                   (m_A[2]() << 2) |
+			                   (m_A[3]() << 3);
+
+			const bool is_bad = (a == static_cast<unsigned>(m_bad_addr()));
+
+			// Write phase. RWQ low = write. Stuck/flipped cells refuse writes
+			// (the cell's storage element can't be programmed any more).
+			if (!m_RWQ())
+			{
+				if (!(is_bad && m_mode() != MODE_NORMAL))
+				{
+					m_ram[a] = m_DI() ? 1 : 0;
+				}
+			}
+
+			// Read phase. The output reflects either the stored bit or the
+			// fault-injected value at BAD_ADDR.
+			unsigned out = m_ram[a];
+			if (is_bad)
+			{
+				switch (m_mode())
+				{
+					case MODE_STUCK_HI: out = 1;        break;
+					case MODE_STUCK_LO: out = 0;        break;
+					case MODE_FLIP:     out ^= 1;       break;
+					default: /* NORMAL */               break;
+				}
+			}
+			m_DO.push(out & 1, ACCESS_DELAY);
+		}
+
+		object_array_t<logic_input_t, 4> m_A;
+		logic_input_t  m_CEQ;
+		logic_input_t  m_RWQ;
+		logic_input_t  m_DI;
+		logic_output_t m_DO;
+		param_int_t    m_bad_addr;
+		param_int_t    m_mode;
+		state_container<std::array<uint8_t, NUM_CELLS>> m_ram;
+		nld_power_pins m_power_pins;
+	};
+
+	NETLIB_DEVICE_IMPL(bad_ram_cell, "BAD_RAM_CELL",
+		"+CEQ,+A0,+A1,+A2,+A3,+RWQ,+DI,@VCC,@GND")
+
+} // namespace netlist::devices
